# Copy thành .env và điền giá trị thật. File .env không được commit.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173
OMR_ENGINE_BASE_URL=http://localhost:8000
OMR_UPLOAD_DIR=uploads/omr

# --- Mail (SMTP) ---
# Gmail: bật 2FA → tạo App Password tại https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-gmail@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password
APP_MAIL_FROM=your-gmail@gmail.com
APP_MAIL_FROM_NAME=AROS
APP_MAIL_FRONTEND_URL=http://localhost:5173

# --- Cloudflare Turnstile (server Secret Key only; Site Key stays on FE) ---
TURNSTILE_SECRET_KEY=
