# Copy thành .env và điền giá trị thật. File .env không được commit.
# Trên Render/hosting: khai báo cùng tên biến trong Dashboard > Environment.

# --- Server ---
PORT=8080

# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# --- JWT ---
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Auth cookie (refresh token) ---
# Local: Secure=false, SameSite=Lax | Prod (FE/BE khác domain HTTPS): Secure=true, SameSite=None
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_REUSE_GRACE_SECONDS=30

# --- CORS (Frontend origins, comma-separated) ---
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173

# --- OMR Engine ---
OMR_ENGINE_BASE_URL=http://localhost:8000
OMR_UPLOAD_DIR=uploads/omr

# --- Mail ---
# provider: smtp (local/Gmail) hoặc resend (Render deploy)
APP_MAIL_PROVIDER=smtp

# --- Mail SMTP (khi provider=smtp) ---
# Gmail: bật 2FA → App Password tại https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=aros.edu.system@gmail.com
SPRING_MAIL_PASSWORD=

# --- Mail Resend (khi provider=resend) ---
# Đăng ký tại https://resend.com → API Keys → Create
APP_MAIL_RESEND_API_KEY=

# --- Mail chung ---
APP_MAIL_FROM=onboarding@resend.dev
APP_MAIL_FROM_NAME=AROS
APP_MAIL_FRONTEND_URL=https://aros-front-end.vercel.app/

# --- Cloudflare Turnstile (server Secret Key only; Site Key stays on FE) ---
TURNSTILE_SECRET_KEY=

# --- Exam status sync (ms) ---
APP_EXAM_STATUS_SYNC_FIXED_DELAY_MS=60000

# --- Gemini + Class Analysis Agent ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
APP_AGENT_MAX_STEPS=6
APP_AGENT_MIN_SUBMITTED=1
