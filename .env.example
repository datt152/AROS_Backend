# Copy thành .env và điền giá trị thật. File .env không được commit.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-frontend.example.com
OMR_ENGINE_BASE_URL=https://your-omr-engine.example.com
OMR_UPLOAD_DIR=/tmp/uploads/omr
